# ensure this file is tracked
!.gitignore

# don't track assets generated from source
generated-assets
.cache

# don't track node packages
node_modules

# don't track error logs
.error_schema.log
logs

# don't track OS related files (windows/macos/linux)
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Icon
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
*.lnk
*.cab
*.msi
*.msix
*.msm
*.msp
[Dd]esktop.ini
.directory
.fuse_hidden*
.Trash-*
.nfs*

# Don't include VSCode generated files
.vscode
*.code-workspace

# Don't track common virtual environment directories
venv/

# Don't track deprecated workflows
.github/workflows/deploy.yml
.github/workflows/test-build.yml

# Additional
__pycache__
build
output
build_info
build_log
.tox/
.pytest_cache/
*.egg-info/
dist/

# Appendix downloads are source assets, even when global rules ignore SQL/ZIP files.
!/src/appendix-a-datasets/*.sql
!/src/appendix-a-datasets/practical_db_data_files.zip
